# The only key the app needs. Accent analysis runs on Google's Gemini.
GEMINI_API_KEY=AI...

# Optional — feedback storage and the leaderboard. Without these the app still
# works; corrections just stay in the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Optional — signs the token that lets a donated clip be uploaded. Falls back to
# SUPABASE_SERVICE_KEY when unset.
FEEDBACK_SECRET=
